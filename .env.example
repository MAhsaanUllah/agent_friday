# Active model in LiteLLM provider-prefixed format.
# Supported prefixes: gemini/, openai/, anthropic/, deepseek/, openrouter/, groq/
LLM_MODEL=gemini/gemini-2.0-flash

# Provider API keys - only the key for the active provider is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# CORS origin of the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5174

# Server API key (X-API-Key header). If set, all /agent/* and /mcp/* routes require it.
# Leave empty for local/open dev mode. Generate e.g. with: python -c "import secrets;print(secrets.token_hex(16))"
AGENT_API_KEY=
